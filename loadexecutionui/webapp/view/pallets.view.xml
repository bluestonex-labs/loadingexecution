<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:tnt="sap.tnt" xmlns:core="sap.ui.core" controllerName="com.sysco.wm.loadexecutionui.controller.pallets">
    <Page title="{i18n>title}" showHeader="false" showFooter="false" showSubHeader="false" enableScrolling="false">
        <HBox width="100%" height="100%" alignContent="Center" alignItems="Center">
            <VBox width="55%" alignItems="Center" alignContent="Center" class="responsiveBox sapUiNoMarginEnd" fitContainer="true" height="100%">
                <VBox id="vbList" width="100%" height="100%" alignItems="Center" alignContent="Center" justifyContent="Center" class="">
                    <ScrollContainer width="100%" height="100%" vertical="true" horizontal="false">
                        <List items="{path: '/value'}" id="palletsLst" mode="SingleSelectMaster" visible="{path: 'Status_ID', formatter: '.formatter.hideLoaded'}" sticky="HeaderToolbar">
                            <headerToolbar>
                            <OverflowToolbar design="Transparent" style="Clear">
                            <HBox id="hbHeader" height="auto" width="60%">
                                    <Title id="total" text="0" class="sapUiTinyMargin sapUiNoMarginEnd" level="H2" titleStyle="H2"/>
                                    <Label text="{i18n>open}" class="sapUiNoMarginBegin sapUiNoMarginEnd sapUiTinyMargin css1"/>

                                    <Title id="frozen" text="0" level="H2" titleStyle="H2" class="sapUiNoMarginEnd sapUiTinyMargin"/>
                                    <core:Icon src="sap-icon://fridge" class="sapUiNoMarginBegin sapUiTinyMargin css1" color="blue">
                                        <core:layoutData>
                                            <FlexItemData growFactor="1"/>
                                        </core:layoutData>
                                    </core:Icon>

                                    <Title id="fresh" text="0" level="H2" titleStyle="H2" class="sapUiNoMarginEnd sapUiTinyMargin"/>
                                    <core:Icon src="sap-icon://e-care" class="sapUiNoMarginBegin sapUiTinyMargin css1" color="green">
                                        <core:layoutData>
                                            <FlexItemData growFactor="1"/>
                                        </core:layoutData>
                                    </core:Icon>
                                </HBox>
                                </OverflowToolbar>
                            </headerToolbar>
                            <items>
                                <CustomListItem>
                                        <HBox width="102%" alignContent="Center" alignItems="Center" fitContainer="true" justifyContent="Center" class="customMarginPalletList">
                                            <!--<HBox width="100%" justifyContent="Center" class="roundBoxBlue" alignItems="Center" alignContent="Center" fitContainer="true">-->   
                                                <!--<VBox width="100%" alignItems="Center" alignContent="Center" justifyContent="Center">
                                                    <Text text="{i18n>palletid}" class="whiteText "/>
                                                    <Text text="{PALLETID}" class="whiteText "/>
                                                </VBox>-->
                                                <VBox alignContent="Start" alignItems="Start" justifyContent="Center" class="roundBoxBlue" fitContainer="true" width="170px">
                                                    <HBox alignContent="Center" alignItems="Center">
                                                        <Text text="{i18n>palletid}" class="whiteText "/>
                                                        <Text text="{PALLETID}" class="whiteText "/>
                                                    </HBox>
                                                    <HBox width="100%" justifyContent="Center" alignItems="Center" alignContent="Center" fitContainer="true">
                                                        <Text text="{actualRoute} {PickTypeDescription}" class="whiteText sapUiTinyMarginBegin" wrapping="false"/>
                                                        <ToolbarSpacer/>
                                                        <ObjectStatus class="sapUiTinyMargin whiteIcon" icon="{FrozenIcon}" state="{FrozenState}"/>
                                                    </HBox>
                                                </VBox>
                                            <!--</HBox>-->
                                            <ObjectStatus class="sapUiTinyMargin largeIcon" icon="sap-icon://sys-enter" state="{State}" visible="{Visible}"/>
                                        </HBox>
                                </CustomListItem>
                            </items>
                        </List>
                    </ScrollContainer>
                </VBox>
            </VBox>
            <VBox width="60%" alignItems="Center" alignContent="Center" justifyContent="Center" class="responsiveBox sapUiTinyMargin sapUiNoMarginBegin" fitContainer="true" height="100%">
                <Title class="loadVehicleFilters loadVehicleSelected sapUiTinyMarginTop" text="{i18n>scanText}" wrapping="true"/>
                <Input id="inPalletID" width="12rem" value="" class="largeWidthPallet" placeholder="{i18n>enterPalletID}" change="onScanPallet"/>

                <Button id="confirmLoad" class="largeWidthPallet blackButton sapUiTinyMarginTopBottom tallButton" text="{i18n>confirmLoad}" press="onConfirmLoaded"/>
                <Button id="close" class="largeWidthPallet blackButton tallButton" text="{i18n>close}" press="onRouteClose"/>
            </VBox>
        </HBox>
    </Page>
</mvc:View>