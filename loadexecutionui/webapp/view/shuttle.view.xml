<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:tnt="sap.tnt" xmlns:core="sap.ui.core" controllerName="com.sysco.wm.loadexecutionui.controller.shuttle">
    <Page title="{i18n>title}" showHeader="false" showFooter="false">
        <HBox id="hbShuttle" width="100%" height="100%" alignItems="Center" fitContainer="true" alignContent="Center" justifyContent="Center">
            <VBox width="50%" alignItems="Center" alignContent="Center" justifyContent="Center" fitContainer="true" height="100%">
                <Button id="shuttleid" class="largeWidthPallet blackButton sapUiSmallMarginBottom" text="" enabled="false"/>
                <Button id="routeid" class="largeWidthPallet blackButton sapUiSmallMarginBottom" text="{i18n>route}" enabled="false"/>
            </VBox>
            <VBox width="50%" alignItems="Center" alignContent="Center" justifyContent="Center" class="responsiveBox" fitContainer="true" height="100%">
                    <Title text="{i18n>vehicleID}" id="idSuggestionsSearch" width="10rem"/>
                    <ComboBox xmlns="sap.m" id="productInput" items="{path: 'vehIdMod>/'}" placeholder="{i18n>vehicleIDSuggest}">
                        <items>
                            <core:Item xmlns:core="sap.ui.core" key="{vehIdMod>VEHICLEID}" text="{vehIdMod>VEHICLEID}"/>
                        </items>
                    </ComboBox>
                    <!--<Input id="productInput" width="12rem" placeholder="{i18n>vehicleIDSuggest}" showSuggestion="true" suggest=".onSuggest" suggestionItems="{vehIdMod>/}" suggestionItemSelected=".onSuggestionItemSelected">
                        <suggestionItems>
                            <core:Item text="{vehIdMod>VEHICLEID}"/>
                        </suggestionItems>
                    </Input>-->
                    <Button text="{i18n>confirm}" press="onVehicleConfirm" class="largeWidthPallet blackButton tallButton"/>
            <items/>
            </VBox>
        </HBox>
    </Page>
</mvc:View>